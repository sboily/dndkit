# Settings read from the environment. Nothing loads this file: put the ones
# you need in your MCP client's server entry (its "env"), or export them.

# Where campaigns live; an absolute path (default: the per-user data dir).
DNDKIT_STORAGE_DIR=/absolute/path/to/dndkit-data

# DEBUG, INFO (default), WARNING or ERROR, written to stderr.
DNDKIT_LOG_LEVEL=INFO

# Serve the live web pages (table, players' phones, backstage) on this port.
DNDKIT_WEB_PORT=8765
# 127.0.0.1 (default) for this machine only; 0.0.0.0 for phones on the LAN.
DNDKIT_WEB_HOST=127.0.0.1
# How phones reach the pages, when the server cannot tell (http:// or https://).
# DNDKIT_WEB_URL=http://192.168.1.20:8765

# A server of its own, over HTTP (stdio by default): MCP at /mcp, and /health.
# DNDKIT_TRANSPORT=http
# 127.0.0.1 (default); beyond this machine, a token is required.
# DNDKIT_HTTP_HOST=127.0.0.1
# DNDKIT_HTTP_PORT=8000
# Every MCP request carries it as "Authorization: Bearer <token>".
# DNDKIT_HTTP_TOKEN=output of: openssl rand -hex 32
